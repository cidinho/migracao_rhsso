# Copie para .env e preencha. Variáveis de ambiente do sistema têm precedência sobre este arquivo.

# --- RH-SSO / Keycloak 16 (obrigatórias) ---
# URL base incluindo o contexto /auth (padrão do Keycloak 16)
KEYCLOAK_BASE_URL=https://sso.exemplo.com.br/auth
KEYCLOAK_REALM=meu-realm
KEYCLOAK_CLIENT_ID=importador-usuarios
KEYCLOAK_CLIENT_SECRET=

# --- Usuários criados ---
# emailVerified dos usuários criados (true/false)
KC_EMAIL_VERIFIED=true
# Ações obrigatórias no próximo login, separadas por vírgula. Vazio = nenhuma.
# Aceitas: UPDATE_PROFILE, UPDATE_PASSWORD, VERIFY_EMAIL, CONFIGURE_TOTP, terms_and_conditions
KC_NEW_USER_REQUIRED_ACTIONS=UPDATE_PROFILE

# --- Controle de taxa (WAF) ---
# Requisições simultâneas ao RH-SSO
KC_MAX_CONCURRENCY=1
# Intervalo mínimo entre o início de requisições consecutivas (ms)
KC_MIN_INTERVAL_MS=300
# Retentativas para 429/502/503/504 e erros de rede
KC_MAX_RETRIES=5
# Base do backoff exponencial (ms): base, 2x base, 4x base... (máx. 60 s)
KC_RETRY_BASE_DELAY_MS=1000
# Timeout de cada requisição ao RH-SSO (ms)
KC_REQUEST_TIMEOUT_MS=30000
# Tamanho da página ao listar membros dos grupos
KC_MEMBERS_PAGE_SIZE=500

# --- Aplicação ---
GROUPS_CACHE_TTL_SECONDS=300
# Tamanho máximo do CSV em bytes (5 MB)
UPLOAD_MAX_BYTES=5242880
UPLOAD_MAX_ROWS=10000
# Tempo que um job finalizado fica disponível para consulta (min)
JOB_RETENTION_MINUTES=120
AUDIT_LOG_DIR=./logs

# --- Proxy corporativo (opcional) ---
HTTPS_PROXY=
HTTP_PROXY=
NO_PROXY=localhost,127.0.0.1
# ATENÇÃO: NODE_EXTRA_CA_CERTS NÃO funciona neste arquivo; defina-a como variável do sistema.

# --- Servidor HTTP do backend ---
# 127.0.0.1 = aceita conexões só da própria máquina (recomendado quando o frontend roda no mesmo host)
HOST=127.0.0.1
PORT=3001
