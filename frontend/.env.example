# Copie para .env. Em produção (node .output/server/index.mjs) o .env NÃO é lido automaticamente:
# defina as variáveis no sistema ou use: node --env-file=.env .output/server/index.mjs

# Endereço do backend NestJS, visto a partir do servidor Nuxt (o navegador nunca acessa direto)
NUXT_BACKEND_URL=http://localhost:3001

# Interface e porta do servidor Nuxt
HOST=0.0.0.0
PORT=3000
